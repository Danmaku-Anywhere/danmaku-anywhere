{
  "name": "@danmaku-anywhere/danmaku-model",
  "version": "0.2.0",
  "description": "Shared danmaku data model and XML conversion",
  "author": "Mr-Quin",
  "repository": {
    "type": "git",
    "url": "https://github.com/Danmaku-Anywhere/danmaku-anywhere",
    "directory": "packages/danmaku-model"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "!dist/src/**/test-data"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true,
    "main": "dist/src/index.js",
    "types": "dist/src/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      }
    }
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc",
    "lint": "tsc && biome check --fix",
    "lint:ci": "biome ci",
    "type-check": "tsc --noEmit",
    "dev": "tsc -w"
  },
  "dependencies": {
    "@nodable/entities": "^3.1.0",
    "fast-xml-parser": "^5.12.1"
  },
  "peerDependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "vitest": "^5.1.2",
    "zod": "^4.6.7"
  }
}
